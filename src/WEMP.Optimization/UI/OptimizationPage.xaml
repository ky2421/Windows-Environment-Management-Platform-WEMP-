<UserControl x:Class="WEMP.Optimization.UI.OptimizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:WEMP.Optimization.UI"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与工具栏 -->
        <DockPanel Grid.Row="0">
            <TextBlock Text="系统优化"
                       FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}"
                        Content="一键优化"
                        Command="{Binding OneKeyOptimizeCommand}"
                        IsEnabled="{Binding CanOperate}" />
                <Button Style="{StaticResource ToolButton}"
                        Content="优化选中项"
                        Command="{Binding OptimizeSelectedCommand}"
                        IsEnabled="{Binding CanOperate}" />
                <Button Style="{StaticResource ToolButton}"
                        Content="回滚选中项"
                        Command="{Binding RollbackSelectedCommand}"
                        IsEnabled="{Binding CanOperate}" />
                <Button Style="{StaticResource ToolButton}"
                        Content="回滚全部"
                        Command="{Binding RollbackAllCommand}"
                        IsEnabled="{Binding CanOperate}" />
            </StackPanel>
        </DockPanel>

        <!-- 状态与提示 -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" Foreground="#444444" />
            <TextBlock Text="部分优化（服务、注册表 HKLM、DNS、电源）需要管理员权限，非管理员运行时将记录失败原因。"
                       Foreground="#AA7700"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Visibility="{Binding ShowPermissionHint, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 优化项列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,0" Padding="12" Background="#F5F6F8" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0" />

                                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <Border Background="#E3E9F3" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding CategoryText}" FontSize="11" />
                                        </Border>
                                        <Border Background="#F0E7D4" CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock FontSize="11" Text="{Binding Recommendation}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Principle}" FontSize="12" Foreground="#666666"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Risk}" FontSize="11" Foreground="#AA6666"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding StateText}"
                                           Foreground="{Binding IsSuccess, Converter={x:Static ui:OptimizationPage.SuccessForegroundConverter}}"
                                           FontSize="12"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 历史记录 -->
        <TextBlock Grid.Row="3" Text="最近操作记录" FontWeight="Bold" Margin="0,14,0,0" />
        <ScrollViewer Grid.Row="4" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ExecutedAt, StringFormat=HH:mm:ss}" FontSize="12" Foreground="#888888" />
                            <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{Binding Result}" FontSize="12"
                                       Foreground="{Binding Result, Converter={x:Static ui:OptimizationPage.ResultForegroundConverter}}" />
                            <TextBlock Grid.Column="3" Text="{Binding ItemCode}" FontSize="12" Foreground="#666666"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
