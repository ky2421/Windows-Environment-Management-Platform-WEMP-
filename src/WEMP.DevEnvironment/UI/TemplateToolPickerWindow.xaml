<Window x:Class="WEMP.DevEnvironment.UI.TemplateToolPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择部署工具"
        Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="选择部署工具" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                <Run Text="模板：" /><Run Text="{Binding TemplateName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,10,0,12" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                   Text="勾选需要安装的工具；必需工具默认选中且不可取消。" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsOptional}"
                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                    <TextBlock Margin="6,0,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontFamily="{StaticResource MonoFont}" Text="{Binding Version, Mode=OneWay}" />
                                    <Border Margin="10,0,0,0" CornerRadius="3" Padding="6,1" Background="{StaticResource ControlBackgroundBrush}">
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="可选" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOptional}" Value="False">
                                                            <Setter Property="Text" Value="必需" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="部署" Width="88" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="OnDeployClick" />
        </StackPanel>
    </Grid>
</Window>
