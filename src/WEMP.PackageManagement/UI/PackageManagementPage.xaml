<UserControl x:Class="WEMP.PackageManagement.UI.PackageManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <ui:ResultToBrushConverter x:Key="ResultToBrush" xmlns:ui="clr-namespace:WEMP.PackageManagement.UI" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="软件包管理" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center" Foreground="#666666" />
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="#666666" FontSize="12"
                   Text="基于 Windows 程序包管理器（winget）：同步已安装软件、一键升级、按分组批量安装。" />

        <TabControl Grid.Row="2" Margin="0,12,0,0">
            <!-- 已安装软件 -->
            <TabItem Header="已安装软件">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="重新同步" Command="{Binding RefreshInstalledCommand}"
                                DockPanel.Dock="Right" Padding="12,4" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Installed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,4" Background="#F5F6F8" CornerRadius="4">
                                        <DockPanel>
                                            <Button Content="卸载" Padding="10,2" DockPanel.Dock="Right"
                                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock FontSize="11" Foreground="#888888">
                                                    <Run Text="{Binding PackageId, Mode=OneWay}" /><Run Text="  " />
                                                    <Run Text="{Binding Version, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 可升级 -->
            <TabItem Header="可升级">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="升级全部" Command="{Binding UpgradeAllCommand}"
                                DockPanel.Dock="Right" Padding="12,4" />
                        <Button Content="刷新" Command="{Binding RefreshUpgradableCommand}"
                                DockPanel.Dock="Right" Padding="12,4" Margin="0,0,8,0" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Upgradable}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,4" Background="#F5F6F8" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="11" Foreground="#888888" />
                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="#666666" HorizontalAlignment="Right">
                                                <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Available, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 软件分组 -->
            <TabItem Header="软件分组">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- 分组列表与创建 -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="新建分组" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,0" ToolTip="分组名称" />
                        <TextBox Text="{Binding NewGroupDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,0" ToolTip="描述（可选）" />
                        <Button Content="创建分组" Command="{Binding CreateGroupCommand}"
                                Margin="0,4,0,8" Padding="10,4" HorizontalAlignment="Left" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="SoftwareGroups"
                                                     Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888888" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 选中分组明细 -->
                    <StackPanel Grid.Column="1">
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="一键安装该分组" Command="{Binding InstallGroupCommand}"
                                    CommandParameter="{Binding SelectedGroup}" DockPanel.Dock="Right" Padding="12,4" />
                            <Button Content="删除分组" Command="{Binding DeleteGroupCommand}"
                                    CommandParameter="{Binding SelectedGroup}" DockPanel.Dock="Right"
                                    Padding="12,4" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SelectedGroup.Name}" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBox Text="{Binding NewItemPackageId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="包 ID，如 Microsoft.VisualStudioCode" />
                            <Button Content="添加" Command="{Binding AddItemCommand}" DockPanel.Dock="Right"
                                    Padding="12,4" Margin="8,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SelectedGroup.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,4" Background="#F5F6F8" CornerRadius="4">
                                        <DockPanel>
                                            <Button Content="移除" Padding="8,2" DockPanel.Dock="Right"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding PackageId}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 操作记录 -->
            <TabItem Header="操作记录">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,4" Background="#F5F6F8" CornerRadius="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#888888">
                                            <Run Text="{Binding StartedAt, StringFormat=MM-dd HH:mm:ss, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Action, Mode=OneWay}" /><Run Text="  " />
                                            <Run Text="{Binding PackageId, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="8,0,0,0" FontSize="11"
                                                   Foreground="{Binding Result, Converter={StaticResource ResultToBrush}}">
                                            <Run Text="{Binding Result, Mode=OneWay}" /><Run Text="（" /><Run Text="{Binding ExitCode, Mode=OneWay}" /><Run Text="）" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
