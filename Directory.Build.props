<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WEMP</RootNamespace>

    <!-- Versioning (SemVer) -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Metadata -->
    <Authors>WEMP Contributors</Authors>
    <Product>Windows Environment Management Platform</Product>
    <Description>Windows 环境管理平台</Description>
    <Copyright>Copyright (c) 2026 WEMP Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ky2421/Windows-Environment-Management-Platform-WEMP-</RepositoryUrl>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
